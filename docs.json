              "quickstart",
              "usage"
            ]
          },
          {
            "group": "Wrappers",
            "pages": [
              "wrappers"
            ]
          },
          {
            "group": "Development",
            "pages": [
              "creating-wrappers",
              "contributing",
              "development"
            ]
          }
        ]
      }
